train_config {
  sparse_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    constant_learning_rate {
    }
  }
  dense_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    constant_learning_rate {
    }
  }
  num_epochs: 1
  save_checkpoints_steps: 0
  use_tensorboard: false
  save_checkpoints_epochs: 1
}
eval_config {
}
export_config {
  exporter_type: "best"
  best_exporter_metric: "auc_is_click_light"
}
data_config {
  batch_size: 4096
  dataset_type: OdpsDataset
  label_fields: "is_click"
  label_fields: "is_conversion"
  num_workers: 24
  fg_mode: FG_BUCKETIZE
  odps_data_compression: "ZSTD"
}
feature_configs {
  id_feature {
    feature_name: "item_id"
    expression: "item:item_id"
    embedding_dim: 32
    hash_bucket_size: 3000000
  }
}
feature_configs {
  id_feature {
    feature_name: "mmb_id"
    expression: "user:mmb_id"
    embedding_dim: 32
    zch {
      zch_size: 1810299
      eviction_interval: 2
      lfu {}
      threshold_filtering_func: "lambda x: dynamic_threshold_filter(x, 3.0)"
    }
  }
}
feature_configs {
  id_feature {
    feature_name: "page"
    expression: "user:page"
    embedding_dim: 32
    hash_bucket_size: 2470
  }
}
feature_configs {
  id_feature {
    feature_name: "day_h"
    expression: "user:day_h"
    embedding_dim: 8
    hash_bucket_size: 240
  }
}
feature_configs {
  id_feature {
    feature_name: "week_day"
    expression: "user:week_day"
    embedding_dim: 4
    hash_bucket_size: 70
  }
}
feature_configs {
  id_feature {
    feature_name: "gender"
    expression: "user:gender"
    embedding_dim: 32
    vocab_list: ["女", "男"]
  }
}
feature_configs {
  id_feature {
    feature_name: "age_group"
    expression: "user:age_group"
    embedding_dim: 8
    hash_bucket_size: 8090
  }
}
feature_configs {
