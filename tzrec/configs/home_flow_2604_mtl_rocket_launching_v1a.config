      id_feature {
        feature_name: "first_cate_id"
        expression: "item:first_cate_id"
        embedding_dim: 8
        hash_bucket_size: 300
      }
    }
    features {
      id_feature {
        feature_name: "second_cate_id"
        expression: "item:second_cate_id"
        embedding_dim: 8
        hash_bucket_size: 2000
      }
    }
    features {
      id_feature {
        feature_name: "third_cate_id"
        expression: "item:third_cate_id"
        embedding_dim: 12
        hash_bucket_size: 20000
      }
    }
    features {
      id_feature {
        feature_name: "price_tag"
        expression: "item:price_tag"
        embedding_dim: 8
        hash_bucket_size: 500
      }
    }
    features {
      id_feature {
        feature_name: "promotion_channel"
        expression: "item:promotion_channel"
        embedding_dim: 4
        hash_bucket_size: 100
      }
    }
    features {
      id_feature {
        feature_name: "publish_user"
        expression: "item:publish_user"
        embedding_dim: 8
        hash_bucket_size: 2120
      }
    }
    features {
      id_feature {
        feature_name: "site"
        expression: "item:site"
        embedding_dim: 8
        hash_bucket_size: 420
      }
    }
    features {
      id_feature {
        feature_name: "spu_id"
        expression: "item:spu_id"
        embedding_dim: 28
        hash_bucket_size: 3000000
      }
    }
    features {
      id_feature {
        feature_name: "discount_intensity"
        expression: "item:discount_intensity"
        embedding_dim: 8
        hash_bucket_size: 180
      }
    }
    features {
      id_feature {
        feature_name: "dianpupingfen"
        expression: "item:dianpupingfen"
        embedding_dim: 4
        hash_bucket_size: 70
      }
    }
    features {
      id_feature {
        feature_name: "pinpaidengji"
        expression: "item:pinpaidengji"
        embedding_dim: 4
        vocab_list: ["一线品牌", "二线品牌", "三线品牌", "四线品牌"]
      }
    }
    features {
      id_feature {
        feature_name: "dianpufensi"
        expression: "item:dianpufensi"
        embedding_dim: 4
        hash_bucket_size: 90
      }
    }
    features {
      id_feature {
        feature_name: "item_type"
        expression: "item:item_type"
        embedding_dim: 4
        hash_bucket_size: 50
      }
    }
    features {
      id_feature {
        feature_name: "username"
        expression: "item:username"
        embedding_dim: 12
        hash_bucket_size: 45550
      }
    }
    features {
      raw_feature {
        feature_name: "ts"
        expression: "user:ts"
        embedding_dim: 8
        boundaries: [10.0, 60.0, 1800.0, 3600.0, 10800.0, 43200.0, 259200.0]
      }
    }
  }
}
