  }
  num_class: 2
  mtl_rocket_launching {
    # ===== Shared bottom (booster & light; light uses detached output) =====
    #share_mlp {
    #  use_ln: true
    #  hidden_units: [512, 256]
    #}
    # ===== Booster trunk: cross -> deep -> ple -> parallel towers =====
    cross {
      cross_num: 4
      low_rank: 128
    }
    deep {
       use_ln: true
       hidden_units: [512, 256, 128]
    }
    extraction_networks {
      network_name: "cgc_layer1"
      expert_num_per_task: 2
      share_num: 2
      task_expert_net { hidden_units: [512, 256] use_ln: true }
      share_expert_net { hidden_units: [512, 256] use_ln: true }
    }
    extraction_networks {
      network_name: "cgc_layer2"
      expert_num_per_task: 2
      share_num: 2
      task_expert_net { hidden_units: [512, 256] use_ln: true }
      share_expert_net { hidden_units: [512, 256] use_ln: true }
    }
    # parallel multi-task towers (ctr_tower + cvr_tower); booster & light share
    # the declaration. mlp hidden_units aligns with light_task_mlp below to
    # enable per-tower feature-based distillation.
    task_towers {
      tower_name: "is_click"
      label_name: "is_click"
      weight: 1.0
      num_class: 1
      mlp { hidden_units: [128, 64, 32] use_ln: true }
      losses { binary_cross_entropy {} }
      train_metrics { auc {} }
      metrics { auc {} }
    }
    task_towers {
      tower_name: "is_conversion"
      label_name: "is_conversion"
      weight: 1.0
      num_class: 1
      mlp { hidden_units: [128, 64, 32] use_ln: true }
      losses { binary_cross_entropy {} }
      train_metrics { auc {} }
      metrics { auc {} }
    }
    # ===== Light (student, served online): share.detach() -> light_mlp -> heads =====
    light_mlp {
      use_ln: true
      hidden_units: [256, 128]
    }
    light_task_mlp {
      use_ln: true
      hidden_units: [128, 64, 32]
    }
    # ===== Distillation (per-tower logit hint + feature-based) =====
    feature_based_distillation: true
    feature_distillation_function: COSINE
    hint_loss_weight: 1.0
  }
}