  train_config {
  sparse_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    cosine_annealing_learning_rate {
      T_max: 6300
      min_learning_rate: 0.0001
      warmup_learning_rate: 0.0
      warmup_size: 1000
    }
  }
  dense_optimizer {
    adam_optimizer {
      lr: 0.001
      beta1: 0.9
      beta2: 0.999
    }
    cosine_annealing_learning_rate {
      T_max: 6300
      min_learning_rate: 0.0001
      warmup_learning_rate: 0.0
      warmup_size: 1000
    }
    part_optimizers {
      adamw_optimizer {
        lr: 0.001
        weight_decay: 0.01
        beta1: 0.9
        beta2: 0.999
      }
      cosine_annealing_learning_rate {
        T_max: 6300
        min_learning_rate: 0.0001
        warmup_learning_rate: 0.0
        warmup_size: 1000
      }
      regex_pattern: "(.*)(epnet\\.gate|afp.*classifiers|afp.*bit_classifiers|cdot\\.compress_mlp|task_towers\\..*tower_layers|task_towers\\..*gate_mlps)\\.(.*)\\.weight"
    }
    part_optimizers {
      adamw_optimizer {
        lr: 0.001
        weight_decay: 0.01
        beta1: 0.9
        beta2: 0.999
      }
      cosine_annealing_learning_rate {
        T_max: 6300
        min_learning_rate: 0.0001
        warmup_learning_rate: 0.0
        warmup_size: 1000
      }
      regex_pattern: "(.*)cdot\\.sub_compress_weight"
    }
  }
  num_epochs: 1
  save_checkpoints_steps: 500
  use_tensorboard: true
  save_checkpoints_epochs: 0
}
eval_config {
}
export_config {
}
