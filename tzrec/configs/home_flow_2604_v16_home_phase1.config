    feature_names: "user__kv_related_goods_ids_conversion_rt3h"
    feature_names: "user__kv_spu_id_cvr_60d"
    feature_names: "user__kv_item_type_conversion_rt1h"
    feature_names: "site"
    feature_names: "discount_intensity"
    feature_names: "day_h"
    feature_names: "keyword"
    feature_names: "user__cnt_click_15d"
    feature_names: "user__ctr_60d"
    feature_names: "dev_brand_x_price_tag_fg"
    feature_names: "brand_x_price_tag_fg"
    group_type: DEEP
  }
  pepnet_dcn_ple {
    main_group_name: "all"
    epnet_hidden_unit: 256
    ppnet_hidden_units: [512, 256, 128]
    ppnet_activation: "nn.ReLU"
    dcnv2 {
      cross_num: 4
      low_rank: 256
    }
    cdot {
      input_dim: 32
      output_dim: 4
      mid_dim: 32
      compress_hidden_units: [512, 374]
    }
    cdot_group_name: "domain"
    bias_group_name: "domain"
    lhuc_group_name: "domain"
    extraction_networks {
      network_name: "layer1"
      expert_num_per_task: 2
      share_num: 2
      task_expert_net {
        hidden_units: [512, 256]
        activation: "Swish"
      }
      share_expert_net {
        hidden_units: [512, 256]
        activation: "Swish"
      }
    }
    extraction_networks {
      network_name: "layer2"
      expert_num_per_task: 2
      share_num: 2
      task_expert_net {
        hidden_units: [256, 128]
        activation: "Swish"
      }
      share_expert_net {
        hidden_units: [256, 128]
        activation: "Swish"
      }
    }
    task_towers {
      tower_name: "ctr"
      label_name: "is_click"
      weight: 4.5
      train_metrics {
        auc {}
      }
      metrics {
        auc {}
      }
      metrics {
        grouped_auc { grouping_key: "mmb_id" }
      }
      losses {
        binary_cross_entropy {}
      }
      mlp {
        hidden_units: [512, 256, 128]
        use_ln: true
        dropout_ratio: 0.1
      }
    }
    task_towers {
      tower_name: "cvr"
      label_name: "is_conversion"
      weight: 1.0
      sample_weight_name: "search_weight"
      train_metrics {
        auc {}
      }
      metrics {
        auc {}
      }
      metrics {
        grouped_auc { grouping_key: "mmb_id" }
      }
      losses {
        binary_cross_entropy {}
      }
      mlp {
        hidden_units: [512, 256, 128]
        use_ln: true
        dropout_ratio: 0.1
      }
      task_space_indicator_label: "is_click"
      in_task_space_weight: 1
      out_task_space_weight: 0
    }
    cvr_add_ctr_logits: false
    # --- AFP (Automatic Feature Partitioning) for APPNet ---
    afp_enabled: true
    afp_mode: "feature_wise"
    afp_hidden_units: [64, 32]
    afp_temperature: 1.0
    afp_min_temperature: 0.1
    afp_entropy_reg_weight: 0.05
    # === HoME Phase 1: Expert Normalization + Swish ===
    expert_normalization: true
    expert_norm_type: "layer"
  }
  use_ctcvr_loss: true
}
