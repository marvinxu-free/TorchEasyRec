train_config {
  sparse_optimizer {
    adam_optimizer {
      lr: 0.001
      gradient_clipping: true 
      max_gradient: 0.1
    }
    constant_learning_rate {
    }
  }
  dense_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    constant_learning_rate {
    }
  }
  num_epochs: 1
  save_checkpoints_steps: 0
  use_tensorboard: false
  save_checkpoints_epochs: 1
}
eval_config {
}
export_config {
  exporter_type: "best"
  best_exporter_metric: "auc_is_click"
}
data_config {
  batch_size: 4096
  dataset_type: OdpsDataset
  label_fields: "is_click"
  label_fields: "is_conversion"
  num_workers: 24
  fg_mode: FG_BUCKETIZE
  odps_data_compression: "ZSTD"
}
